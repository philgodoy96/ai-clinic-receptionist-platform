APP_NAME=ai-clinic-receptionist-platform
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/clinic_receptionist
REDIS_URL=redis://localhost:6379/0
APPOINTMENT_HOLD_TTL_SECONDS=300
RABBITMQ_URL=amqp://clinic:clinic@localhost:5672/
EMAIL_JOB_QUEUE_NAME=email_jobs
EMAIL_JOB_DISPATCH_ENABLED=false

RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

EMAIL_PROVIDER=fake
RESEND_API_KEY=

LLM_PROVIDER=fake
LLM_ENABLED=true
