APP_NAME=ai-clinic-receptionist-platform
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/clinic_receptionist
REDIS_URL=redis://localhost:6379/0
APPOINTMENT_HOLD_TTL_SECONDS=300
RABBITMQ_URL=amqp://clinic:clinic@localhost:5672/
EMAIL_JOB_QUEUE_NAME=email_jobs
# RabbitMQ wake-up only; retry schedule is controlled by EmailJob.next_attempt_at in Postgres.
EMAIL_JOB_DISPATCH_ENABLED=false
EMAIL_JOB_MAX_ATTEMPTS=3
EMAIL_JOB_BACKOFF_BASE_SECONDS=30
EMAIL_JOB_BACKOFF_MAX_SECONDS=900
EMAIL_JOB_LOCK_TTL_SECONDS=300

RETELL_ENABLED=false
RETELL_API_KEY=
RETELL_WEBHOOK_VERIFICATION_ENABLED=true
RETELL_WEBHOOK_SECRET=
RETELL_ALLOW_INSECURE_WEBHOOKS=false
RETELL_SIGNATURE_HEADER_NAME=x-retell-signature
RETELL_REQUEST_MAX_BODY_BYTES=262144

# Public demo Retell example (uncomment with RETELL_ENABLED; pair with guardrails in production)
# RETELL_ENABLED=true
# RETELL_WEBHOOK_VERIFICATION_ENABLED=true
# RETELL_WEBHOOK_SECRET=whsec_...
# RETELL_ALLOW_INSECURE_WEBHOOKS=false
# RETELL_API_KEY=key_...

EMAIL_PROVIDER=fake
# At-least-once delivery. When EMAIL_PROVIDER=resend, idempotency keys are passed to Resend.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=clinic-demo@example.test
# EMAIL_REPLY_TO=
EMAIL_PROVIDER_REQUEST_TIMEOUT_SECONDS=10

# Hosted public demo example (use only with guardrails enabled)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=Clinic <noreply@example.com>

LLM_PROVIDER=fake
LLM_ENABLED=true
LLM_MAX_PRIMARY_ATTEMPTS=2
LLM_FALLBACK_ENABLED=false
# LLM_PRIMARY_PROVIDER=fake
# LLM_FALLBACK_PROVIDER=bedrock
# LLM_MAX_FALLBACK_ATTEMPTS=1
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=your-model-id
# AWS_REGION=us-east-1
# BEDROCK_REQUEST_TIMEOUT_SECONDS=10
# BEDROCK_MAX_RETRIES=0
# BEDROCK_TEMPERATURE=0
# BEDROCK_MAX_TOKENS=800

# Public demo Groq example (primary LLM for hosted demo; pair with guardrails in production)
# LLM_PRIMARY_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_REQUEST_TIMEOUT_SECONDS=10
# GROQ_MAX_OUTPUT_TOKENS=800
# GROQ_TEMPERATURE=0
# GROQ_RESPONSE_FORMAT=json_schema

# Receptionist response phrasing (deterministic by default)
RECEPTIONIST_RESPONSE_MODE=deterministic
RECEPTIONIST_RESPONSE_VALIDATE_OUTPUT=true
# RECEPTIONIST_RESPONSE_LLM_PROVIDER=groq
# RECEPTIONIST_RESPONSE_MAX_TOKENS=400
# RECEPTIONIST_RESPONSE_TEMPERATURE=0

# Public demo (disabled by default — safe for local development)
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_GUARDRAILS_ENABLED=false
TRUST_PROXY_HEADERS=false

# Per-IP demo limits (used when guardrails are enabled)
DEMO_CHAT_MESSAGES_PER_MINUTE_PER_IP=10
DEMO_CHAT_MESSAGES_PER_DAY_PER_IP=100
DEMO_RETELL_TOOL_CALLS_PER_MINUTE_PER_IP=30
DEMO_RETELL_TOOL_CALLS_PER_DAY_PER_IP=300
DEMO_APPOINTMENTS_PER_DAY_PER_IP=5
DEMO_CONFIRMATION_EMAILS_PER_DAY_PER_IP=5

# Global demo limits (used when guardrails are enabled)
DEMO_GLOBAL_CHAT_MESSAGES_PER_DAY=2000
DEMO_GLOBAL_APPOINTMENTS_PER_DAY=200
DEMO_GLOBAL_CONFIRMATION_EMAILS_PER_DAY=200

# Public demo example (uncomment to enable; always pair with guardrails in production)
# PUBLIC_DEMO_MODE=true
# PUBLIC_DEMO_GUARDRAILS_ENABLED=true
# TRUST_PROXY_HEADERS=true