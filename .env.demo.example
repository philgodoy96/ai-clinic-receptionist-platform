# Hosted public demo deployment template.
# Copy values into your platform secret manager or deployment env config.
# Do not commit real credentials. For local development, use .env.example instead.
#
# Provider-specific secrets are required only when that provider is enabled.
# Fake providers remain valid for smoke tests; this template targets a hosted demo.

# --- app ---
APP_NAME=ai-clinic-receptionist-platform
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# --- database ---
# Required in production public demo mode. Use a managed PostgreSQL URL (non-localhost).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.example.com:5432/clinic_receptionist

# --- redis ---
# Required in production public demo mode for appointment holds and demo guardrails.
REDIS_URL=redis://:PASSWORD@redis.example.com:6379/0
APPOINTMENT_HOLD_TTL_SECONDS=300

# --- rabbitmq ---
# Required when EMAIL_JOB_DISPATCH_ENABLED=true.
RABBITMQ_URL=amqp://USER:PASSWORD@rabbitmq.example.com:5672/
EMAIL_JOB_QUEUE_NAME=email_jobs
EMAIL_JOB_DISPATCH_ENABLED=true
EMAIL_JOB_MAX_ATTEMPTS=3
EMAIL_JOB_BACKOFF_BASE_SECONDS=30
EMAIL_JOB_BACKOFF_MAX_SECONDS=900
EMAIL_JOB_LOCK_TTL_SECONDS=300

# --- clinic ---
CLINIC_TIMEZONE=America/New_York
CLINIC_BUSINESS_DAYS=monday,tuesday,wednesday,thursday,friday
CLINIC_BUSINESS_HOURS_START=09:00
CLINIC_BUSINESS_HOURS_END=17:00
CLINIC_NAME=Demo Clinic
CLINIC_LOCALE=en-US
# Voice agents should call get_clinic_context before discussing relative dates.

# --- LLM / Groq ---
# Keep LLM_PROVIDER=fake for smoke tests without external LLM calls.
# When LLM_PRIMARY_PROVIDER=groq (or LLM_PROVIDER=groq), GROQ_API_KEY and GROQ_MODEL are required.
LLM_PROVIDER=fake
# LLM_PRIMARY_PROVIDER=groq
LLM_ENABLED=true
LLM_MAX_PRIMARY_ATTEMPTS=2
LLM_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=800
GROQ_TEMPERATURE=0
GROQ_RESPONSE_FORMAT=json_schema
# Optional Bedrock settings (required only when bedrock is the configured provider):
# LLM_PRIMARY_PROVIDER=bedrock
# BEDROCK_MODEL_ID=<your-bedrock-model-id>
# AWS_REGION=us-east-1

# Receptionist response phrasing (deterministic by default)
RECEPTIONIST_RESPONSE_MODE=deterministic
RECEPTIONIST_RESPONSE_VALIDATE_OUTPUT=true
# When RECEPTIONIST_RESPONSE_MODE=llm, configure RECEPTIONIST_RESPONSE_LLM_PROVIDER if needed.
# RECEPTIONIST_RESPONSE_LLM_PROVIDER=groq
# RECEPTIONIST_RESPONSE_MAX_TOKENS=400
# RECEPTIONIST_RESPONSE_TEMPERATURE=0

# --- email / Resend ---
# Keep EMAIL_PROVIDER=fake for smoke tests without outbound mail.
# When EMAIL_PROVIDER=resend, RESEND_API_KEY and EMAIL_FROM_ADDRESS are required.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=clinic-demo@example.test
EMAIL_REPLY_TO=
EMAIL_PROVIDER_REQUEST_TIMEOUT_SECONDS=10
HUMAN_ESCALATION_NOTIFICATION_EMAIL=clinic-staff@example.test

# --- Retell ---
# Retell is optional for chat-only demos. When RETELL_ENABLED=true with
# RETELL_WEBHOOK_VERIFICATION_ENABLED=true, RETELL_WEBHOOK_SECRET is required.
RETELL_ENABLED=false
RETELL_API_KEY=
RETELL_WEBHOOK_VERIFICATION_ENABLED=true
RETELL_WEBHOOK_SECRET=
RETELL_ALLOW_INSECURE_WEBHOOKS=false
RETELL_SIGNATURE_HEADER_NAME=x-retell-signature
RETELL_REQUEST_MAX_BODY_BYTES=262144

# --- public demo guardrails ---
# Required for hosted unauthenticated demo. Guardrails default on when PUBLIC_DEMO_MODE=true
# unless PUBLIC_DEMO_GUARDRAILS_ENABLED is explicitly set in the environment.
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_GUARDRAILS_ENABLED=true
TRUST_PROXY_HEADERS=true
# Allow voice booking to create minimal demo patients (.test emails only) when not found
VOICE_PATIENT_INTAKE_MODE=demo_auto_create
DEMO_CHAT_MESSAGES_PER_MINUTE_PER_IP=10
DEMO_CHAT_MESSAGES_PER_DAY_PER_IP=100
DEMO_RETELL_TOOL_CALLS_PER_MINUTE_PER_IP=30
DEMO_RETELL_TOOL_CALLS_PER_DAY_PER_IP=300
DEMO_APPOINTMENTS_PER_DAY_PER_IP=5
DEMO_CONFIRMATION_EMAILS_PER_DAY_PER_IP=5
DEMO_GLOBAL_CHAT_MESSAGES_PER_DAY=2000
DEMO_GLOBAL_APPOINTMENTS_PER_DAY=200
DEMO_GLOBAL_CONFIRMATION_EMAILS_PER_DAY=200

# --- observability ---
# Structured JSON logs are written to stdout by default (no env var required).
# Health endpoints: GET /api/v1/health and GET /api/v1/health/dependencies
# Optional OpenTelemetry / Prometheus env vars are not part of this demo template yet.
