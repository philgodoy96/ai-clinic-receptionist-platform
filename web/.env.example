# Public frontend configuration only.
# Copy to .env.local for local development. Do not add provider keys here.

# Backend API origin used by the demo shell (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Portfolio links shown in the footer (optional overrides; defaults are hardcoded in lib/config.ts).
NEXT_PUBLIC_GITHUB_URL=https://github.com/philgodoy96/ai-clinic-receptionist-platform
NEXT_PUBLIC_ARCHITECTURE_DOC_URL=https://github.com/philgodoy96/ai-clinic-receptionist-platform/tree/main/docs/architecture

# Enable the public voice demo UI (requires backend RETELL_WEB_CALL_ENABLED and agent setup).
NEXT_PUBLIC_VOICE_DEMO_ENABLED=false
