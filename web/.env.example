# Public frontend configuration only.
# Copy to .env.local for local development. Do not add provider keys here.

# Backend API origin used for display and server-side references (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only proxy target for browser chat requests via /api/v1/* rewrites.
API_PROXY_TARGET=http://localhost:8000

# Portfolio links shown in the footer.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username/ai-clinic-receptionist-platform
NEXT_PUBLIC_ARCHITECTURE_DOC_URL=https://github.com/your-username/ai-clinic-receptionist-platform/tree/main/docs/architecture

# Placeholder flag for a future Retell web voice demo (not implemented yet).
NEXT_PUBLIC_VOICE_DEMO_ENABLED=false
